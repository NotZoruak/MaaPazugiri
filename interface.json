{
    "interface_version": 2,
    "name": "maa-pazugiri",
    "label": "MaaPazugiri",
    "github": "https://github.com/NotZoruak/MaaPazugiri",
    "version": "v1.0.0-beta.12",
    "description": "MaaPazugiri MaaFW project",
    "controller": [
        {
            "name": "Adb",
            "label": "Android / Emulator",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "base",
            "label": "Base",
            "path": [
                "./resource/base"
            ]
        }
    ],
    "agent": [
        {
            "child_exec": "uv",
            "child_args": [
                "run",
                "python",
                "agent/main.py"
            ]
        }
    ],
    "option": {
        "轻量识别": {
            "type": "switch",
            "label": "轻量识别",
            "description": "仅识别普通饿鬼、强化饿鬼、特殊黑色饿鬼和炸弹，跳过障碍物（含青铜钟），减少识别计算。轻量模式不提供障碍物信息。",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "Flag_LightweightRecognition": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭",
                    "pipeline_override": {
                        "Flag_LightweightRecognition": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "No"
        }
    },
    "import": [
        "./tasks/start_game.json",
        "./tasks/claim_rewards.json",
        "./tasks/resident_battle.json"
    ]
}
