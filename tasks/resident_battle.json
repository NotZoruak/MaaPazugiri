                },
                {
                    "name": "No",
                    "label": "关闭"
                }
            ],
            "default_case": "Yes"
        },
        "碎玉换体": {
            "type": "switch",
            "label": "碎玉换体",
            "description": "达到最大换体次数或剩余宝玉数量小于等于宝玉保留量时，任一条件满足即结束任务。",
            "cases": [
                {
