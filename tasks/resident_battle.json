        "选择作战策略": {
            "type": "select",
            "label": "选择作战策略",
            "description": "在侧边栏编辑并保存策略后，可在此处选择要使用的策略。",
            "cases": [
                {
                    "name": "default",
                    "label": "默认策略",
                    "pipeline_override": {
                        "RB_RunBattle": {
                            "action": {
                                "param": {
                                    "custom_action_param": {"strategy_id": "default"}
                                }
                            }
                        }
                    }
                }
            ],
            "default_case": "default"
        },
        "出战前返回主页面": {
            "type": "switch",
            "label": "出战前返回主页面",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "pipeline_override": {
                        "RB_BackToMainPage": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭"
                }
            ],
            "default_case": "No"
        },
        "使用体力回复药": {
            "type": "switch",
            "label": "使用体力回复药",
            "cases": [
                {
                    "name": "Yes",
                    "label": "开启",
                    "option": ["使用当日限定1体力回复药"],
                    "pipeline_override": {
                        "BattleSettlement_OpenStaminaRecovery": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "关闭"
                }
            ],
            "default_case": "No"
        },
        "使用当日限定1体力回复药": {
