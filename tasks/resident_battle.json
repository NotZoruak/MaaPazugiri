{
    "task": [
        {
            "name": "ResidentBattle",
            "label": "常驻作战",
            "entry": "ResidentBattle",
            "option": ["选择章节", "选择部队"],
            "doc": ["重复次数可在任务设置中调整；选择章节后，可在对应的关卡下拉框中选择目标关卡，并选择目标部队。"],
            "repeatable": true,
            "repeat_count": 1
